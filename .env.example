# Gemini API Key (or loaded automatically from ~/.hermes/.env)
GEMINI_API_KEY=your_gemini_api_key_here

# Model for real-time speech-to-text
OMI_GEMINI_STT_MODEL=gemini-3.8-flash

# Dynamic [1s pre + 5s core + 1s post] sliding window settings (in seconds)
OMI_PRE_OVERLAP_SEC=1.0
OMI_CORE_WINDOW_SEC=5.0
OMI_POST_LOOKAHEAD_SEC=1.0

# Optional wake word and proactive research interval
OMI_WAKE_WORD=hermes
OMI_RESEARCH_INTERVAL=90
