# Process variables override this project-local file.
# Uncomment and replace for a standalone installation. GOOGLE_API_KEY also works.
# GEMINI_API_KEY=your_gemini_api_key_here

OMI_STT_MODE=live
OMI_GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# The following model/window/thinking settings apply only to optional OMI_STT_MODE=batch.
OMI_GEMINI_STT_MODEL=gemini-3.8-flash
# Lower reasoning effort for latency-sensitive transcription; medium/high are also supported.
# Gemini 3.8 does not support minimal.
OMI_GEMINI_THINKING_LEVEL=low

# Total processing budget includes all attempts/backoffs; queue age applies only while live.
OMI_WINDOW_DEADLINE_SEC=20.0
OMI_MAX_WINDOW_AGE_SEC=45.0

# Dynamic audio windows, in seconds.
OMI_PRE_OVERLAP_SEC=1.0
OMI_CORE_WINDOW_SEC=8.0
OMI_POST_LOOKAHEAD_SEC=1.0
OMI_IDLE_FLUSH_SEC=8.0
OMI_RMS_THRESHOLD=80.0

# Continuous raw-audio playback history, separate from the pending STT queue.
OMI_RING_BUFFER_SEC=300
