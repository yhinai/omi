# Process variables override this file; ~/.hermes/.env is the fallback.
# Uncomment and replace for a standalone installation. GOOGLE_API_KEY also works.
# GEMINI_API_KEY=your_gemini_api_key_here

OMI_GEMINI_STT_MODEL=gemini-3.8-flash

# Dynamic audio windows, in seconds.
OMI_PRE_OVERLAP_SEC=1.0
OMI_CORE_WINDOW_SEC=5.0
OMI_POST_LOOKAHEAD_SEC=1.0
OMI_IDLE_FLUSH_SEC=8.0
OMI_RMS_THRESHOLD=80.0

# Continuous raw-audio playback history, separate from the pending STT queue.
OMI_RING_BUFFER_SEC=300

# Optional Hermes integration (an empty wake word disables voice activation).
OMI_WAKE_WORD=hermes
OMI_RESEARCH_INTERVAL=90
OMI_HERMES_LIVE_WEBHOOK=http://127.0.0.1:8644/webhooks/omi-live
OMI_HERMES_RESEARCH_WEBHOOK=http://127.0.0.1:8644/webhooks/omi-research
