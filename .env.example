# Process variables override this project-local file. GOOGLE_API_KEY also works.
# GEMINI_API_KEY=your_gemini_api_key_here

# Match the token in the phone's /v1/listen URL.
# OMI_STREAM_TOKEN=choose-a-private-stream-token

OMI_GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Skip unsent audio older than this during normal operation.
OMI_MAX_AUDIO_AGE_SEC=45.0
# Start a new session after this much idle time.
OMI_IDLE_FLUSH_SEC=8.0
# Minimum audio energy for speech detection (RMS).
OMI_RMS_THRESHOLD=80.0
